{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "alpona-studio",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "alpona-studio", "dev"],
      "port": 5173
    },
    {
      "name": "alpona-server",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@alpona/server", "dev"],
      "port": 3001
    },
    {
      "name": "alpona-website",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@alpona/website", "dev", "--port", "4321"],
      "port": 4321,
      "env": { "BASE_PATH": "/" }
    }
  ]
}
