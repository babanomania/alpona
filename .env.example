# ── Agent service ────────────────────────────────────────────────
# Provider: anthropic | openai. Optional — inferred from whichever
# key below is set (Anthropic wins when both are). Leave everything
# unset (or set ALPONA_MOCK=1) to run the demo with deterministic
# fixture responses, no LLM calls.
ALPONA_PROVIDER=

# Anthropic
ANTHROPIC_API_KEY=

# OpenAI — or any OpenAI-compatible server via OPENAI_BASE_URL
# (no key needed for local servers). Load local models with a context
# window of at least 16384 tokens — the dictionary-grounded prompts run
# ~4k tokens before the model writes anything (in LM Studio:
# `lms load <model> --context-length 16384`). LM Studio example:
#   OPENAI_BASE_URL=http://localhost:1234/v1
#   ALPONA_PLANNER_MODEL=google/gemma-4-e4b
#   ALPONA_BINDER_MODEL=google/gemma-4-e4b
#   ALPONA_COPY_MODEL=google/gemma-4-e4b
OPENAI_API_KEY=
OPENAI_BASE_URL=

# 1 = deterministic agent fixtures, no API key needed (demo/CI mode)
ALPONA_MOCK=

# Models per pipeline stage — planner + copy run on a fast model,
# binders on a strong model. Defaults per provider:
#   anthropic: claude-haiku-4-5 / claude-opus-4-8 / claude-haiku-4-5
#   openai:    gpt-5.4-mini    / gpt-5.4         / gpt-5.4-mini
ALPONA_PLANNER_MODEL=
ALPONA_BINDER_MODEL=
ALPONA_COPY_MODEL=

# ── Database ─────────────────────────────────────────────────────
# Postgres (docker compose default), connects as read-only alpona_reader:
#   ALPONA_DB=postgres://alpona_reader:alpona_reader@localhost:5433/alpona
# DuckDB (no Docker required):
#   ALPONA_DB=duckdb:./examples/supply-chain/db/alpona.duckdb
ALPONA_DB=duckdb:./examples/supply-chain/db/alpona.duckdb

# Admin connection used by alpona-db for migrations/seeds (postgres only;
# duckdb uses the same file as ALPONA_DB)
ALPONA_DB_ADMIN=postgres://alpona:alpona@localhost:5433/alpona

# ── Server ───────────────────────────────────────────────────────
ALPONA_PORT=3001
