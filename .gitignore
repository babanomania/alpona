# dependencies
node_modules/

# build outputs
dist/
*.tsbuildinfo

# environment
.env
.env.local

# databases & generated artifacts
*.duckdb
*.duckdb.wal
datasets/*/db/dictionary/dictionary.json

# generated starter dashboards (regenerated by `alpona init`); curated
# reports next to them are committed
datasets/*/reports/starter-*.json

# saved dashboards (local share-URL store)
.alpona/

# logs & caches
*.log
.cache/
coverage/

# demo-video harness: recordings, traces, seeded db (mp4s in website/public are committed)
videos/.cache/
videos/playwright-report/
videos/test-results/

# editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# scratch
.scratch/

# installers
*.dmg

# Astro site build output + generated reference docs
website/dist/
website/.astro/
website/src/content/docs/reference/

.claude/
.agents/