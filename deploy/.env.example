# Alpona docker-compose — everything has a working default.
# An empty file (or no file) boots the full playground: Supabase
# Postgres + mock agent + studio on http://localhost:3001.

# Model key → live agent (omit for the deterministic mock)
OPENAI_API_KEY=
#ANTHROPIC_API_KEY=
#OPENAI_BASE_URL=                # e.g. http://host.docker.internal:1234/v1 for LM Studio

# ── Auth ─────────────────────────────────────────────────────────
# Default: open playground (no login).
#
# Simple shared key:
#AUTH_MODE=apikey
#ALPONA_API_KEY=choose-a-long-random-key
#
# Real Supabase Auth (login screen, per-user dashboards) — add the auth
# overlay and set one shared JWT secret:
#   docker compose -f docker-compose.yml -f docker-compose.auth.yml up
# Then provision the first user (no signup by design):
#   ALPONA_AUTH_URL=http://localhost:3001/auth/v1 ALPONA_JWT_SECRET=$ALPONA_JWT_SECRET \
#     pnpm alpona user add you@example.com
ALPONA_JWT_SECRET=

# Database passwords (defaults are fine for local use)
#POSTGRES_PASSWORD=
#ALPONA_DB_PASSWORD=
#ALPONA_READER_PASSWORD=
