# Alpona docker-compose configuration.
#
#   cp .env.example .env      # then edit the values you care about
#
# Every variable has a working default, so an empty .env still boots the
# full playground (Supabase Postgres + a deterministic mock agent + the
# studio) on http://localhost:3001. Set the values below to go beyond it.

# ── Agent / model provider ───────────────────────────────────────
# Leave the keys blank to use the deterministic mock agent (no key, fully
# offline). Set ONE of these for the live agent:
OPENAI_API_KEY=
#ANTHROPIC_API_KEY=
#
# Optional: pin the provider when both keys are present (anthropic | openai),
# point at an OpenAI-compatible server, or override the per-stage models.
#ALPONA_PROVIDER=
#OPENAI_BASE_URL=                  # e.g. http://host.docker.internal:1234/v1 for LM Studio
#ALPONA_PLANNER_MODEL=
#ALPONA_BINDER_MODEL=
#ALPONA_COPY_MODEL=

# ── Dataset pack ─────────────────────────────────────────────────
#ALPONA_DATASET=supply-chain        # supply-chain | ecommerce | saas-metrics

# ── Auth ─────────────────────────────────────────────────────────
# Default: open playground (no login).
#
# (a) Simple shared key — clients send `Authorization: Bearer <key>`:
#AUTH_MODE=apikey
#ALPONA_API_KEY=choose-a-long-random-key
#
# (b) Real Supabase Auth (login screen + per-user dashboards). Add the
#     auth overlay AND set a strong shared secret — DO NOT ship the
#     default. Generate one with:  openssl rand -hex 32
#
#   docker compose -f docker-compose.yml -f docker-compose.auth.yml up
#
#   Then provision the first user (no public signup, by design):
#   ALPONA_AUTH_URL=http://localhost:3001/auth/v1 ALPONA_JWT_SECRET=$ALPONA_JWT_SECRET \
#     pnpm alpona user add you@example.com
ALPONA_JWT_SECRET=

# ── Database passwords (defaults are fine for local use) ─────────
#POSTGRES_PASSWORD=
#ALPONA_DB_PASSWORD=
#ALPONA_READER_PASSWORD=
