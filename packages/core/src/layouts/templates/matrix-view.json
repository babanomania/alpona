      "maxWidgets": 2,
      "packing": "column",
      "overflow": "truncate",
      "region": { "x": 8, "y": 0, "w": 4, "h": 5 }
    },
    {
      "id": "detail",
      "role": "table",
      "description": "Row-level evidence behind the hot cells.",
      "accepts": ["table"],
      "minWidgets": 0,
      "maxWidgets": 1,
      "packing": "row",
      "overflow": "truncate",
      "region": { "x": 0, "y": 5, "w": 12, "h": 5 }
    }
  ]
