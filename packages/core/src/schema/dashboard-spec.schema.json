{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alpona.dev/schema/dashboard-spec/v1",
  "title": "DashboardSpec",
  "description": "Alpona dashboard specification v1 — a portable, data-free, versioned dashboard artifact.",
  "type": "object",
  "additionalProperties": false,
  "required": ["specVersion", "title", "layout", "params", "widgets"],
  "properties": {
    "specVersion": { "const": 1 },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "layout": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*@[0-9]+$",
      "description": "Pinned layout template reference, e.g. \"ops-monitor@2\""
    },
    "params": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$" },
      "additionalProperties": {
        "type": ["string", "number", "boolean"]
      }
    },
    "widgets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": { "$ref": "#/$defs/widget" }
    }
  },
  "$defs": {
    "widget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "slot", "type", "binding", "copy"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "maxLength": 64 },
        "slot": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "binding": { "$ref": "#/$defs/binding" },
        "props": { "type": "object" },
        "copy": { "$ref": "#/$defs/copy" }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sql", "resultShape"],
      "properties": {
        "sql": { "type": "string", "minLength": 1, "maxLength": 8000 },
        "resultShape": { "$ref": "#/$defs/resultShape" }
      }
    },
    "resultShape": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": { "type": "string" },
        "y": { "type": "string" },
        "series": { "type": "string" },
        "label": { "type": "string" },
        "value": { "type": "string" },
        "delta": { "type": "string" },
        "target": { "type": "string" },
        "size": { "type": "string" },
        "columns": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      }
    },
    "copy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "caption"],
      "properties": {
        "title": { "type": ["string", "null"], "maxLength": 120 },
        "caption": { "type": ["string", "null"], "maxLength": 240 }
      }
    }
  }
}
