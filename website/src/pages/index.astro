---
import '../styles/landing.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const gh = 'https://github.com/babanomania/alpona';
const docs = `${base}/getting-started/playground`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Alpona — Describe it. Alpona draws the pattern.</title>
    <meta
      name="description"
      content="A schema-driven generative UI engine for dashboards. An LLM decides what to show; a deterministic engine decides how it renders. The interface itself is the model's output — a portable spec, not code."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,420;0,9..144,560;1,9..144,420&family=Outfit:wght@300;400;500&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="landing">
    <nav class="lp">
      <a class="brand" href={base || '/'}>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
          <circle cx="12" cy="12" r="9.5" stroke="#e8a44a" stroke-width="1.3" stroke-dasharray="2.4 3.4" />
          <path
            d="M12 6c1.8 2.2 1.8 4 0 6-1.8-2-1.8-3.8 0-6ZM12 18c-1.8-2.2-1.8-4 0-6 1.8 2 1.8 3.8 0 6ZM6 12c2.2-1.8 4-1.8 6 0-2 1.8-3.8 1.8-6 0ZM18 12c-2.2 1.8-4 1.8-6 0 2-1.8 3.8-1.8 6 0Z"
            fill="#c96a4a"></path>
        </svg>
        Alpona
      </a>
      <div class="links">
        <a href={`${base}/getting-started/playground`}>Docs</a>
        <a href="#outcomes">Why</a>
        <a href="#hood">How</a>
        <a href="#quickstart">Quickstart</a>
        <a class="gh" href={gh}>GitHub ↗</a>
      </div>
    </nav>

    <!-- ════ THE SCENE ════ -->
    <div id="scene-wrap">
      <div id="scene">
        <div class="vignette"></div>

        <div class="beat" id="beat-hero">
          <div class="eyebrow">self-serve analytics · open-source</div>
          <h1>Everyone can build<br />dashboards <em>now.</em></h1>
          <p>
            Plain-language requests become live dashboards and answers on your own data —
            generated by an LLM, rendered by a deterministic engine that
            <strong>can only ship what your team approved</strong>. Self-hosted, Apache-2.0.
          </p>
        </div>

        <div class="beat beat-mid" id="beat-1">
          <div class="eyebrow">আলপনা — a learned vocabulary of motifs</div>
          <h2>A fixed vocabulary of motifs.<br /><em>Infinite compositions.</em></h2>
          <p>
            That's what makes it safe: Alpona composes from layouts, widgets, and queries your team
            owns. It never invents a component.
          </p>
        </div>

        <div class="beat beat-mid" id="beat-2">
          <div class="eyebrow">the same points, rearranged</div>
          <h2>The pattern <em>becomes</em> the dashboard.</h2>
          <p>
            One sentence in — a layout is chosen, widgets are bound to real SQL, and copy is written.
            Streamed live, validated end to end.
          </p>
        </div>

        <div class="beat beat-mid" id="beat-3">
          <div class="eyebrow">no code generated</div>
          <h2>The output is a <em>spec</em>, not code.</h2>
          <p>
            Portable. Diffable. Re-parameterizable. Reviewed in a PR and promoted dev → prod — it
            outlives the conversation that created it.
          </p>
          <div class="beat-cta">
            <a class="btn btn-fill" href="/alpona/getting-started/playground">Get started</a>
            <a class="btn btn-line" href="/alpona/videos/alpona-walkthrough.mp4">Watch Demo</a>
          </div>
        </div>

        <div class="scrollcue" id="cue">scroll<i></i></div>
      </div>
    </div>

    <!-- ════ OUTCOMES ════ -->
    <section class="lp" id="outcomes">
      <div class="reveal">
        <div class="kicker">what changes for your team</div>
        <h2 class="title">The dashboard backlog <em>disappears.</em></h2>
        <p class="lede">
          Anyone who can describe what they want to see can build it — on live data, on brand, inside
          the guardrails your team controls.
        </p>
      </div>
      <div class="outcards">
        <div class="outcard reveal">
          <h3>Self-serve, actually</h3>
          <p>
            Ops, finance, and product answer their own questions and assemble their own views. No
            ticket. No sprint. No waiting on the data team.
          </p>
        </div>
        <div class="outcard reveal">
          <h3>Minutes, not quarters</h3>
          <p>
            A new dashboard costs a sentence; iterating on it costs another one. BI rollouts stop
            being projects and start being conversations.
          </p>
        </div>
        <div class="outcard reveal">
          <h3>One source of truth</h3>
          <p>
            Every chart and every answer runs live against your database — no exported snapshots
            quietly going stale inside slide decks.
          </p>
        </div>
      </div>
    </section>

    <!-- ════ JOURNEY ════ -->
    <section class="lp" id="journey">
      <div class="reveal">
        <div class="kicker">how it feels</div>
        <h2 class="title">Describe. Refine. <em>Ask.</em></h2>
      </div>
      <div class="journey">
        <div class="jstep reveal">
          <h4>Describe</h4>
          <span class="say"
            >Ops view for the warehouse team — delays by carrier, stock risk, utilization</span
          >
          <p>
            A live dashboard assembles in seconds — layout chosen, charts bound to real queries,
            streaming onto the screen as it's planned.
          </p>
        </div>
        <div class="jstep reveal">
          <h4>Refine</h4>
          <span class="say">Top 5 only. Make it weekly.</span>
          <p>
            Only that widget changes. Edits land as surgical patches — nothing regenerates that
            didn't need to.
          </p>
        </div>
        <div class="jstep reveal">
          <h4>Ask</h4>
          <span class="say">Which carrier is actually the worst this month?</span>
          <p>
            A direct answer, with the numbers — and the exact query — to back it. Pin it to the board
            if it's worth keeping.
          </p>
        </div>
      </div>
    </section>

    <!-- ════ TRUST ════ -->
    <section class="lp" id="trust">
      <div class="reveal">
        <div class="kicker">why it's dependable</div>
        <h2 class="title">AI flexibility. <em>Design-system discipline.</em></h2>
      </div>
      <div class="schools">
        <div class="school reveal">
          <span class="tag">tools that write code</span>
          <h3>Brilliant demo, fragile Tuesday</h3>
          <p>Code-generating tools have the AI write novel React every time.</p>
          <ul>
            <li>Can break at runtime — in front of stakeholders</li>
            <li>Drifts off your brand and design system</li>
            <li>Output is one-off code nobody owns or reviews</li>
          </ul>
        </div>
        <div class="school ours reveal">
          <span class="tag">alpona</span>
          <h3>On-brand by construction</h3>
          <p>
            The model chooses from layouts and widgets <em>your team approved</em>; a deterministic
            engine renders them.
          </p>
          <ul>
            <li>It cannot ship a component you didn't bless</li>
            <li>Every output is validated before it renders</li>
            <li>Looks like your product, because it's built from your product</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- ════ GOVERNANCE ════ -->
    <section class="lp" id="governance">
      <div class="reveal">
        <div class="kicker">governance</div>
        <h2 class="title">Built to pass review — <em>security's and brand's.</em></h2>
      </div>
      <div class="spec-grid">
        <div class="spec-points reveal">
          <div class="pt">
            <h4>Read-only by construction</h4>
            <p>
              AI-written SQL is parsed, gated, and executed under a database role that cannot write —
              five independent layers between the model and your data.
            </p>
          </div>
          <div class="pt">
            <h4>Every number is auditable</h4>
            <p>
              Each chart and each answer carries the exact query that produced it. "Where did this
              figure come from?" always has an answer.
            </p>
          </div>
          <div class="pt">
            <h4>Dashboards are documents</h4>
            <p>
              Each one is a small JSON spec — reviewed in a PR like any change, versioned, and
              promoted dev → prod. No data inside, ever.
            </p>
          </div>
          <div class="pt">
            <h4>Yours to keep</h4>
            <p>
              Apache-2.0, self-hosted, and able to run fully offline on local models. Your data never
              has to leave your network.
            </p>
          </div>
        </div>
        <div class="spec-code reveal">{'{'}
  <span class="k">"title"</span>: <span class="s">"Warehouse Ops Monitor"</span>,
  <span class="k">"layout"</span>: <span class="s">"ops-monitor@2"</span>, <span class="c">// pinned version</span>
  <span class="k">"params"</span>: {'{'} <span class="k">"from"</span>: <span class="s">"2026-05-01"</span> {'}'},
  <span class="k">"widgets"</span>: [{'{'}
    <span class="k">"slot"</span>: <span class="s">"hero"</span>,
    <span class="k">"type"</span>: <span class="s">"line_chart"</span>,
    <span class="k">"binding"</span>: {'{'}
      <span class="k">"sql"</span>: <span class="s">"SELECT … FROM shipment_performance
              WHERE dispatched &gt;= {'{{params.from}}'} …"</span>
    {'}'}
  {'}'}]
{'}'}
<span class="c">// a whole dashboard. no data. no secrets.
// reviewable like the document it is.</span></div>
      </div>
    </section>

    <!-- ════ UNDER THE HOOD ════ -->
    <section class="lp hood" id="hood">
      <div class="inner">
        <div class="reveal">
          <div class="kicker">for the architects in the room</div>
          <h2 class="title">Under the hood: the agent proposes, <em>the engine disposes.</em></h2>
          <p class="lede">
            Five stages — three model calls, two pure-code gates. The model can only fail in ways the
            system catches.
          </p>
        </div>
        <div class="pipe reveal">
          <div class="stage">
            <span class="glyph">i.</span>
            <h4>Classify</h4>
            <p>A question routes to an answer; a description routes to a build.</p>
          </div>
          <div class="stage">
            <span class="glyph">ii.</span>
            <h4>Plan</h4>
            <p>Layout chosen, slots assigned. The skeleton streams in under a second.</p>
            <span class="mode">fast model</span>
          </div>
          <div class="stage">
            <span class="glyph">iii.</span>
            <h4>Bind</h4>
            <p>One validated SQL query per widget, in parallel. Failures self-heal — once, silently.</p>
            <span class="mode">strong model</span>
          </div>
          <div class="stage">
            <span class="glyph">iv.</span>
            <h4>Compose</h4>
            <p>Slot contracts enforced, grid computed. Pure code; no inference.</p>
            <span class="mode">code</span>
          </div>
          <div class="stage">
            <span class="glyph">v.</span>
            <h4>Copy</h4>
            <p>Titles and one-line insights written from the actual result rows.</p>
            <span class="mode">cheap model</span>
          </div>
        </div>
        <div class="reveal">
          <a class="hood-link" href={`${base}/concepts/architecture`}
            >Read the full architecture &amp; security model in the docs →</a
          >
        </div>
      </div>
    </section>

    <!-- ════ QUICKSTART ════ -->
    <section class="lp" id="quickstart">
      <div class="reveal">
        <div class="kicker">quickstart</div>
        <h2 class="title">No Docker. No API key. <em>Before lunch.</em></h2>
        <p class="lede">
          DuckDB in-process and a deterministic demo agent — have an engineer try the full experience
          today, offline.
        </p>
      </div>
      <div class="qs reveal"><span class="c"># clone & install</span>
git clone https://github.com/babanomania/alpona && cd alpona
pnpm install

<span class="c"># build the example database + a starter-dashboard gallery</span>
pnpm alpona init

<span class="c"># run</span>
pnpm dev   <span class="g">→ studio on :5173</span></div>
    </section>

    <footer class="lp">
      <div class="mark">আলপনা</div>
      <p>
        Apache-2.0 · <a href={gh}>GitHub</a> · <a href={docs}>Docs</a> ·
        <a href={`${base}/roadmap`}>Roadmap</a>
      </p>
      <p
        style="margin-top:14px;font-style:italic;font-family:'Fraunces',serif;color:var(--ivory-dim)"
      >
        Models generate decisions. Engines render them. Specs outlive the conversation.
      </p>
    </footer>

    <script>
      import { initHero } from '../scripts/hero';
      initHero();
    </script>
  </body>
</html>
